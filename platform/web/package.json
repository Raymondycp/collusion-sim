{
  "name": "sim-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc && vite build",
    "snapshot:record": "node scripts/record-snapshot.mjs",
    "build:snapshot": "tsc && vite build --mode snapshot",
    "dev:snapshot": "vite --mode snapshot",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../docs/sim/api/openapi.yaml --default-non-nullable false --empty-objects-unknown -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../docs/sim/api/openapi.yaml --default-non-nullable false --empty-objects-unknown -o src/api/schema.d.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.52.0",
    "monaco-editor": "^0.57.0",
    "motion": "^14.0.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "8.20.0",
    "js-yaml": "4.3.2",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
