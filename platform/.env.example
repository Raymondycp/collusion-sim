# Copy to .env (git-ignored) and fill in. The backend reads .env at start and never writes it. Never print .env.
# DECISIONS-9 §16. A variable in the process environment wins over the same name in .env.

# --- Paid calls ---
# Off unless set to 1, and only after lead approval with a budget cap.
# This line and the process environment both work; the process environment wins.
# (handoff simplify-cut A2)
# SIM_ALLOW_PAID=1

# --- Provider profiles from .env (read-only on the Providers page) ---
# Profile id = <ID> in lower case (OPENCODE_CHAT -> opencode_chat). An id must not start with PROF_ (store profiles use prof_).
# Allowed suffixes: _BASE_URL (required), _PROTOCOL, _KEY, _MAX_CALLS_PER_5H, _DEFAULT_MODEL, _MAX_CONCURRENCY, _NAME, _SESSION_HEADER.
# Any other SIM_PROFILE_* variable stops the server at start, so a typo cannot make a profile without a key.
# A .env profile has no price: calls record cost_usd null, so give runs a max_calls or max_tokens cap.
# _MAX_CALLS_PER_5H counts paid calls on this machine only; teammates who share the key are not seen.
# _MAX_CONCURRENCY: calls in flight at once for this profile, for all runs of this server (default 2).
# _SESSION_HEADER: a header name that carries a stable conversation id (<run_id>:<agent_id>), never a secret.
#   OpenCode Go refuses a call without x-opencode-session (opencode.ai/docs/go).
# _KEY: required as a line (it may be empty); a .env profile never takes its key from the keyring or SIM_KEY_<ID>.
# Protocols: openai_chat | openai_responses | anthropic_messages | google | typesafe_systemone (not built yet).
SIM_PROFILE_OPENCODE_CHAT_BASE_URL=https://opencode.ai/inference/go/openai/v1
SIM_PROFILE_OPENCODE_CHAT_PROTOCOL=openai_chat
SIM_PROFILE_OPENCODE_CHAT_KEY=
SIM_PROFILE_OPENCODE_CHAT_MAX_CALLS_PER_5H=
SIM_PROFILE_OPENCODE_CHAT_SESSION_HEADER=x-opencode-session
# The pilot sellers name gpt-6-luna. Set the default model to deepseek-v4.1-flash, the fallback of DECISIONS-23.
# SIM_PROFILE_OPENCODE_CHAT_DEFAULT_MODEL=
# SIM_PROFILE_OPENCODE_CHAT_MAX_CONCURRENCY=2
# SIM_PROFILE_OPENCODE_CHAT_NAME=OpenCode Go (chat)

# One key can serve several profiles, one per protocol path:
# SIM_PROFILE_OPENCODE_ANTHROPIC_BASE_URL=https://opencode.ai/inference/go/anthropic
# SIM_PROFILE_OPENCODE_ANTHROPIC_PROTOCOL=anthropic_messages
# SIM_PROFILE_OPENCODE_ANTHROPIC_KEY=
# SIM_PROFILE_OPENCODE_GOOGLE_BASE_URL=https://opencode.ai/inference/go/google
# SIM_PROFILE_OPENCODE_GOOGLE_PROTOCOL=google
# SIM_PROFILE_OPENCODE_GOOGLE_KEY=

# --- Key of a store profile (Providers page) ---
# Off by default: POST /provider-profiles needs a key store, so start the server with SIM_KEYRING=1 to use it.
# Prefer .env profiles above. Server-wide: a store profile with a key in the keyring and here stops the server at start.
# SIM_KEY_PROF_01EXAMPLE=

# --- Defaults that pre-fill the run form, the CLI and presets (never read at run time; research runs ignore them) ---
# Roles: SELLER, JUDGE, JUDGE2, HOST_LLM. Per agent: SIM_DEFAULT_<ROLE>_<AGENT>_PROFILE / _MODEL (agent id A to Z).
# SIM_DEFAULT_SELLER_PROFILE=opencode_chat
# SIM_DEFAULT_SELLER_MODEL=
# SIM_DEFAULT_SELLER_B_MODEL=
# SIM_DEFAULT_JUDGE_PROFILE=opencode_chat
# SIM_DEFAULT_JUDGE_MODEL=jev-1.13
# SIM_DEFAULT_JUDGE2_PROFILE=
# SIM_DEFAULT_JUDGE2_MODEL=
# SIM_DEFAULT_HOST_LLM_PROFILE=
# SIM_DEFAULT_HOST_LLM_MODEL=

# --- Server ---
# SIM_ROOT=.
# SIM_DURABLE=1   # DBOS: restart unfinished runs after a crash. Off by default; `serve --durable` sets it.
# SIM_KEYRING=1   # the OS keyring. Off by default; .env profiles need no key store.
# SIM_KEYRING_SERVICE=collusion-sim

# --- Hosted site password (DECISIONS-34) ---
# Set only on the hosted server: the web server then asks every visitor for it (HTTP Basic auth). Empty = no password.
SITE_PASSWORD=
